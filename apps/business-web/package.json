{
  "name": "business-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && pnpm check:display-formatters",
    "check:display-formatters": "node scripts/check-display-formatters.mjs",
    "test": "node --experimental-strip-types --test src/*.test.mjs",
    "test:visual": "pnpm build && playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "pnpm build && playwright test --config=playwright.visual.config.ts --update-snapshots",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
