      },
      "expected": {
        "authorized": true
      }
    },
    {
      "id": "sha256-uppercase-argument-normalized",
      "family": "sha256_validation",
      "request": {
        "sha256_argument": "01E782826AE5182220BD6158F883D01CEB1BCE659DC020E7C511F802A9AA7737",
