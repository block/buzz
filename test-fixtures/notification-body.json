{
  "schemaVersion": 1,
  "notes": [
    "Shared by every mobile platform's notification code; see docs/adr/0002-notification-message-text.md.",
    "input is a message's content; expected is the notification body shown for it.",
    "Lengths are in UTF-16 code units: the body is at most 256, including the ellipsis."
  ],
  "maxLength": 256,
  "cases": [
    {
      "name": "plain text is unchanged",
      "input": "Lunch at noon?",
      "expected": "Lunch at noon?"
    },
    {
      "name": "links show their text, bare URLs stay",
      "input": "See [the docs](https://example.org/docs) or https://example.org/raw",
      "expected": "See the docs or https://example.org/raw"
    },
    {
      "name": "mention links show the name",
      "input": "[@Alice](nostr:npub1exampleexampleexample) can you look?",
      "expected": "@Alice can you look?"
    },
    {
      "name": "images show their alt text",
      "input": "![screenshot.png](https://example.org/s.png)",
      "expected": "screenshot.png"
    },
    {
      "name": "fenced code keeps its text and line breaks, drops the fence and language",
      "input": "Try this:\n```swift\nlet x = 1\n  print(x)\n```\nThen run it.",
      "expected": "Try this:\nlet x = 1\n  print(x)\nThen run it."
    },
    {
      "name": "single-line fenced code keeps its text",
      "input": "Run ```just ci``` first",
      "expected": "Run just ci first"
    },
    {
      "name": "inline code keeps its text",
      "input": "Call `fetch()` again",
      "expected": "Call fetch() again"
    },
    {
      "name": "bold and strikethrough markers are removed",
      "input": "**Ship it** ~~tomorrow~~ today",
      "expected": "Ship it tomorrow today"
    },
    {
      "name": "Markdown inside code is left alone",
      "input": "`**kwargs` and ```\ndef __init__(self, **kw): pass\n```",
      "expected": "**kwargs and def __init__(self, **kw): pass"
    },
    {
      "name": "a combining mark next to a code span's backticks is kept",
      "input": "`x`́ and `́y`",
      "expected": "x́ and ́y"
    },
    {
      "name": "single asterisks, underscores, quotes, lists and headings stay as typed",
      "input": "> quoted\n- item one\n# Heading\n*soft* snake_case",
      "expected": "> quoted\n- item one\n# Heading\n*soft* snake_case"
    },
    {
      "name": "runs of spaces collapse outside code, trailing spaces are removed",
      "input": "a    b   \nc",
      "expected": "a b\nc"
    },
    {
      "name": "CRLF becomes LF and three or more line breaks become one blank line",
      "input": "one\r\ntwo\n\n\n\nthree",
      "expected": "one\ntwo\n\nthree"
    },
    {
      "name": "leading and trailing whitespace is trimmed",
      "input": "\n\n  hi  \n\n",
      "expected": "hi"
    },
    {
      "name": "a message that is only whitespace is empty",
      "input": "  \n\t ",
      "expected": ""
    },
    {
      "name": "exactly 256 UTF-16 units is unchanged",
      "input": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "expected": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    {
      "name": "257 UTF-16 units becomes 255 plus an ellipsis",
      "input": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "expected": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx…"
    },
    {
      "name": "the cap counts UTF-16 units and never splits a character",
      "input": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀",
      "expected": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀…"
    },
    {
      "name": "whitespace before the ellipsis is trimmed",
      "input": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx yyyyyyyyyy",
      "expected": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx…"
    }
  ]
