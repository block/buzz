# Sourced by the generated .git/hooks/* dispatchers (see `rc:` in lefthook.yml)
# before their $LEFTHOOK_BIN-first lookup. Pin dispatch to the Hermit-managed
# lefthook (bin/lefthook -> .lefthook-2.1.3.pkg) so a push from any worktree runs
# the pinned version even when a newer lefthook is on PATH (e.g. Homebrew).
# Resolve via the repo root so it holds regardless of the hook's working dir.
_lefthook_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$_lefthook_root" ] && [ -x "$_lefthook_root/bin/lefthook" ]; then
  LEFTHOOK_BIN="$_lefthook_root/bin/lefthook"
  export LEFTHOOK_BIN
fi
unset _lefthook_root
