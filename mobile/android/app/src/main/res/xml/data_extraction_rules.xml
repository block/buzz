<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. flutter_secure_storage data is encrypted with Android Keystore
     keys that never leave the device, so a restored copy can't be decrypted
     and would leave an unreadable identity behind. Other app data still
     backs up and transfers as before. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
    </device-transfer>
</data-extraction-rules>
