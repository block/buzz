#!/usr/bin/env bash
# buzz-runner — one-shot executor for journal-native hand-offs.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: buzz-runner <handoff-open-event-id> [--dry-run] [--isolation host|podman]
EOF
}

die() {
  echo "buzz-runner: $*" >&2
  exit 1
}

DRY_RUN=0
ISOLATION="host"
OPEN_EVENT_ID=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --isolation)
      [ "$#" -ge 2 ] || die "--isolation requires host or podman"
      ISOLATION="$2"
      shift 2
      ;;
    --isolation=*)
      ISOLATION="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      usage
      die "unknown option: $1"
      ;;
    *)
      [ -z "$OPEN_EVENT_ID" ] || {
        usage
        die "only one handoff event id may be provided"
      }
      OPEN_EVENT_ID="$1"
      shift
      ;;
  esac
done

[ -n "$OPEN_EVENT_ID" ] || {
  usage
  die "a handoff:open event id is required"
}
[[ "$OPEN_EVENT_ID" =~ ^[0-9a-fA-F]{64}$ ]] \
  || die "handoff event id must be 64 hexadecimal characters"
OPEN_EVENT_ID="$(printf '%s' "$OPEN_EVENT_ID" | tr '[:upper:]' '[:lower:]')"

case "$ISOLATION" in
  host) ;;
  podman)
    PODMAN_IMAGE="${BUZZ_RUNNER_IMAGE:-}"
    PODMAN_NETWORK="${BUZZ_RUNNER_NETWORK:-none}"
    PODMAN_CPUS="${BUZZ_RUNNER_CPUS:-2}"
    PODMAN_MEMORY="${BUZZ_RUNNER_MEMORY:-4g}"
    PODMAN_PIDS="${BUZZ_RUNNER_PIDS:-256}"
    PODMAN_TIMEOUT="${BUZZ_RUNNER_TIMEOUT_SECS:-3600}"
    [[ "$PODMAN_IMAGE" =~ @sha256:[0-9a-f]{64}$ ]] \
      || die "BUZZ_RUNNER_IMAGE must be digest-pinned as image@sha256:<64 lowercase hex>"
    [ "$PODMAN_NETWORK" = "none" ] \
      || die "only the explicit no-network Podman policy is currently supported"
    [[ "$PODMAN_CPUS" =~ ^[1-9][0-9]*$ ]] \
      || die "BUZZ_RUNNER_CPUS must be a positive integer"
    [[ "$PODMAN_MEMORY" =~ ^[1-9][0-9]*[mMgG]$ ]] \
      || die "BUZZ_RUNNER_MEMORY must be an integer MiB/GiB value such as 4g"
    [[ "$PODMAN_PIDS" =~ ^[1-9][0-9]*$ ]] \
      || die "BUZZ_RUNNER_PIDS must be a positive integer"
    [[ "$PODMAN_TIMEOUT" =~ ^[1-9][0-9]*$ ]] \
      || die "BUZZ_RUNNER_TIMEOUT_SECS must be a positive integer"
    ;;
  *) die "unsupported isolation backend '$ISOLATION' (expected host or podman)" ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -n "${BUZZ_RUNNER_REPOSITORY:-}" ]; then
  SOURCE_ROOT="$(git -C "$BUZZ_RUNNER_REPOSITORY" rev-parse --show-toplevel 2>/dev/null)" \
    || die "BUZZ_RUNNER_REPOSITORY is not a trusted git checkout: $BUZZ_RUNNER_REPOSITORY"
else
  SOURCE_ROOT="$(git -C "$SCRIPT_DIR/.." rev-parse --show-toplevel 2>/dev/null)" \
    || die "installed copies require BUZZ_RUNNER_REPOSITORY=/absolute/trusted/checkout"
fi
SOURCE_ROOT="$(cd "$SOURCE_ROOT" && pwd)" \
  || die "could not canonicalize the trusted repository path"
COMMON_GIT_DIR="$(git -C "$SOURCE_ROOT" rev-parse --git-common-dir 2>/dev/null)" \
  || die "could not resolve the repository's common git directory"
case "$COMMON_GIT_DIR" in
  /*) ;;
  *) COMMON_GIT_DIR="$SOURCE_ROOT/$COMMON_GIT_DIR" ;;
esac
COMMON_GIT_DIR="$(cd "$COMMON_GIT_DIR" && pwd)" \
  || die "could not resolve the repository's common git directory"
REPOSITORY_HOME="$(dirname "$COMMON_GIT_DIR")"

for dependency in jq git curl sed; do
  command -v "$dependency" >/dev/null 2>&1 \
    || die "required command not found on PATH: $dependency"
done

if [ -n "${BUZZ_RUNNER_BUZZ_CTX:-}" ]; then
  BUZZ_CTX_BIN="$BUZZ_RUNNER_BUZZ_CTX"
elif command -v buzz-ctx >/dev/null 2>&1; then
  BUZZ_CTX_BIN="$(command -v buzz-ctx)"
elif [ -x "$SCRIPT_DIR/buzz-ctx" ]; then
  BUZZ_CTX_BIN="$SCRIPT_DIR/buzz-ctx"
else
  die "buzz-ctx not found on PATH (and sibling scripts/buzz-ctx is unavailable)"
fi
[ -x "$BUZZ_CTX_BIN" ] || die "buzz-ctx is not executable: $BUZZ_CTX_BIN"

CTX_HOME="${BUZZ_CTX_HOME:-${HOME:?HOME must be set}/.buzz-local}"
LOCAL_URL="${BUZZ_CTX_LOCAL:-http://127.0.0.1:7777}"
CLOUD_URL="${BUZZ_CTX_CLOUD:-https://buzz-portable-relay.ted-slusser-a00.workers.dev}"
RUNNER_AGENT="${BUZZ_CTX_AGENT:-unattributed}"
SOVEREIGN_CLIENT="$CTX_HOME/bin/sovereign-client"
KEY_PATH="${BUZZ_CTX_KEY:-$CTX_HOME/node.key}"
HANDOFF_STATE="${BUZZ_HANDOFF_STATE:-$CTX_HOME/bin/buzz-handoff-state}"
TRUSTED_REF="${BUZZ_RUNNER_TRUSTED_REF:-}"

[ -x "$SOVEREIGN_CLIENT" ] \
  || die "missing sovereign client at $SOVEREIGN_CLIENT"
[ -f "$KEY_PATH" ] || die "missing node key at $KEY_PATH"
[ -x "$HANDOFF_STATE" ] \
  || die "missing signature-aware handoff reducer at $HANDOFF_STATE"
[ -n "$TRUSTED_REF" ] \
  || die "BUZZ_RUNNER_TRUSTED_REF must name the configured trusted repository base"

query_events_at() {
  local relay="$1" filter="$2" result
  result="$("$SOVEREIGN_CLIENT" query "$KEY_PATH" "$relay" "$filter" 2>/dev/null)" \
    || return 1
  printf '%s' "$result" | sed 's/^200 //'
}

query_events_both() {
  local filter="$1" local_events cloud_events
  local_events="$(query_events_at "$LOCAL_URL" "$filter")" \
    || die "could not read the local lifecycle view"
  cloud_events="$(query_events_at "$CLOUD_URL" "$filter")" \
    || die "could not read the rendezvous lifecycle view"
  jq -cn --argjson local "$local_events" --argjson cloud "$cloud_events" \
    '$local + $cloud | unique_by(.id)'
}

OPEN_FILTER="$(jq -cn --arg id "$OPEN_EVENT_ID" \
  '[{kinds:[1], ids:[$id]}]')" \
  || die "could not build the handoff:open query"
OPEN_RESULTS="$(query_events_both "$OPEN_FILTER")" \
  || die "handoff:open event query failed"
printf '%s' "$OPEN_RESULTS" | jq -e 'type == "array"' >/dev/null \
  || die "handoff:open query returned invalid event data"
OPEN_EVENT="$(printf '%s' "$OPEN_RESULTS" | jq -ce --arg id "$OPEN_EVENT_ID" '
  [.[] | select((.id | ascii_downcase) == $id)]
  | unique_by(.id)
  | select(length == 1)
  | .[0]
')" || die "expected exactly one event with id $OPEN_EVENT_ID"

printf '%s' "$OPEN_EVENT" | jq -e '
  .kind == 1
  and any(.tags[]?; length >= 2 and .[0] == "t" and .[1] == "handoff:open")
' >/dev/null || die "event $OPEN_EVENT_ID is not a kind-1 handoff:open event"

HANDOFF_SPEC="$(printf '%s' "$OPEN_EVENT" | jq -ce '
  .content
  | fromjson
  | select(type == "object")
  | select(.title | type == "string" and length > 0)
  | select(.scope | type == "string" and length > 0)
  | select(.base_commit | type == "string" and length > 0)
  | select(.acceptance | type == "string" and length > 0)
  | select(.embodiment | type == "object")
  | select(.embodiment.stdin | type == "string" and length > 0)
  | select(.embodiment.network | type == "string" and length > 0)
  | select(.embodiment.trust | type == "string" and length > 0)
  | select(.embodiment.tooling | type == "string" and length > 0)
')" || die "handoff event content is not a valid open spec"

ARTIFACTS="$(printf '%s' "$HANDOFF_SPEC" | jq -ce '
  (if has("artifacts") then .artifacts else [] end)
  | select(
      type == "array"
      and all(.[]; type == "string" and test("^[0-9a-fA-F]{64}$"))
    )
')" || die "handoff artifacts must be an array of 64-hex sha256 strings"
TAG_ARTIFACTS="$(printf '%s' "$OPEN_EVENT" | jq -ce '
  [.tags[]? | select(length >= 2 and .[0] == "x") | .[1]]
  | select(all(.[]; type == "string" and test("^[0-9a-fA-F]{64}$")))
')" || die "handoff event contains an invalid x-tag artifact"
jq -en --argjson spec "$ARTIFACTS" --argjson tags "$TAG_ARTIFACTS" \
  '($spec | sort) == ($tags | sort)' >/dev/null \
  || die "handoff content artifacts do not match the event x tags"

TITLE="$(printf '%s' "$HANDOFF_SPEC" | jq -r '.title')"
SCOPE="$(printf '%s' "$HANDOFF_SPEC" | jq -r '.scope')"
ACCEPTANCE="$(printf '%s' "$HANDOFF_SPEC" | jq -r '.acceptance')"
BASE_COMMIT="$(printf '%s' "$HANDOFF_SPEC" | jq -r '.base_commit')"
[[ "$BASE_COMMIT" =~ ^[0-9a-f]{40}$ ]] \
  || die "base_commit must be a canonical lowercase 40-character object id"
RESOLVED_COMMIT="$(git -C "$SOURCE_ROOT" rev-parse --verify \
  "${BASE_COMMIT}^{commit}" 2>/dev/null)" \
  || die "base_commit does not resolve to a local commit: $BASE_COMMIT"
[ "$RESOLVED_COMMIT" = "$BASE_COMMIT" ] \
  || die "base_commit resolution changed identity: $BASE_COMMIT -> $RESOLVED_COMMIT"
TRUSTED_COMMIT="$(git -C "$SOURCE_ROOT" rev-parse --verify \
  "${TRUSTED_REF}^{commit}" 2>/dev/null)" \
  || die "trusted repository base does not resolve: $TRUSTED_REF"
git -C "$SOURCE_ROOT" merge-base --is-ancestor "$BASE_COMMIT" "$TRUSTED_COMMIT" \
  || die "base_commit is not reachable from trusted base $TRUSTED_REF ($TRUSTED_COMMIT)"

LIFECYCLE_FILTER='[{"kinds":[1],"#t":["handoff:open","handoff:claim","handoff:return","handoff:close"]}]'
LIFECYCLE_EVENTS="$(query_events_both "$LIFECYCLE_FILTER")"
HANDOFF_STATE_JSON="$(printf '%s' "$LIFECYCLE_EVENTS" \
  | "$HANDOFF_STATE" --open "$OPEN_EVENT_ID")" \
  || die "could not reduce handoff lifecycle"
RUNNER_SIGNER_KEY="$KEY_PATH"
if [ -f "$CTX_HOME/agents/$RUNNER_AGENT.key" ]; then
  RUNNER_SIGNER_KEY="$CTX_HOME/agents/$RUNNER_AGENT.key"
fi
RUNNER_PUBKEY="$("$SOVEREIGN_CLIENT" pubkey "$RUNNER_SIGNER_KEY")" \
  || die "could not resolve runner signing identity"
LIFECYCLE_STATE="$(printf '%s' "$HANDOFF_STATE_JSON" | jq -r '.state')"
CLAIMANT_PUBKEY="$(printf '%s' "$HANDOFF_STATE_JSON" | jq -r '.claimant_pubkey // empty')"
CLAIM_NEEDED=0
case "$LIFECYCLE_STATE" in
  OPEN)
    printf '%s' "$HANDOFF_STATE_JSON" | jq -e --arg signer "$RUNNER_PUBKEY" \
      '.allowed_claimants | index($signer) != null' >/dev/null \
      || die "runner key $RUNNER_PUBKEY is not an allowed claimant"
    CLAIM_NEEDED=1
    ;;
  CLAIMED)
    [ "$CLAIMANT_PUBKEY" = "$RUNNER_PUBKEY" ] \
      || die "handoff is claimed by another signer: $CLAIMANT_PUBKEY"
    ;;
  CONFLICT) die "handoff has a deterministic multi-signer claim conflict" ;;
  *) die "handoff is not executable from lifecycle state $LIFECYCLE_STATE" ;;
esac

EVENT_PREFIX="${OPEN_EVENT_ID:0:12}"
WORKTREE_PATH="$REPOSITORY_HOME/.claude/worktrees/runner-$EVENT_PREFIX"
[ ! -e "$WORKTREE_PATH" ] \
  || die "runner worktree path already exists: $WORKTREE_PATH"

if [ "$DRY_RUN" -eq 1 ]; then
  ARTIFACT_COUNT="$(printf '%s' "$ARTIFACTS" | jq 'length')"
  cat <<EOF
buzz-runner dry run
  event:      $OPEN_EVENT_ID
  title:      $TITLE
  runner:     $RUNNER_AGENT (${RUNNER_PUBKEY:0:12}…)
  isolation:  $ISOLATION
  base:       $BASE_COMMIT ($RESOLVED_COMMIT)
  trusted:    $TRUSTED_REF ($TRUSTED_COMMIT)
  worktree:   $WORKTREE_PATH
  artifacts:  $ARTIFACT_COUNT
  lifecycle:  $LIFECYCLE_STATE

Plan:
  1. Create a detached worktree at the resolved base commit.
  2. Generate HANDOFF.md and fetch x-tag artifacts through buzz-ctx.
  3. Claim the handoff through buzz-ctx only if it remains unclaimed.
  4. Run the agent only after exclusive relay claiming and Podman gates ship.
  5. Capture git diff, announce it through buzz-ctx, and post handoff:return.

No worktree, artifact fetch, lifecycle post, or codex execution was performed.
EOF
  exit 0
fi

STATE_DIR=""
PROMPT_FILE=""
LAST_MESSAGE_FILE=""
RETURN_SPEC_FILE=""
TEMP_INDEX_FILE=""
WORKTREE_CREATED=0
WORKTREE_REPORTED=0
CLAIM_MAY_EXIST=0
RETURN_POSTED=0
DIFF_SHA=""
FAILURE_REASON="unexpected runner failure"

report_worktree() {
  if [ "$WORKTREE_CREATED" -eq 1 ] && [ "$WORKTREE_REPORTED" -eq 0 ]; then
    printf 'worktree: %s\n' "$WORKTREE_PATH"
    WORKTREE_REPORTED=1
  fi
}

cleanup_state() {
  [ -n "$STATE_DIR" ] || return 0
  rm -f -- "$PROMPT_FILE" "$LAST_MESSAGE_FILE" "$RETURN_SPEC_FILE" \
    "$TEMP_INDEX_FILE" "$STATE_DIR/emergency-return.json"
  rmdir "$STATE_DIR" 2>/dev/null || true
}

cleanup_preclaim_worktree() {
  if [ "$WORKTREE_CREATED" -eq 1 ] && [ "$CLAIM_MAY_EXIST" -eq 0 ]; then
    git -C "$SOURCE_ROOT" worktree remove --force "$WORKTREE_PATH" \
      || echo "buzz-runner: could not remove pre-claim worktree $WORKTREE_PATH" >&2
    WORKTREE_CREATED=0
  fi
}

evidence_json() {
  local summary="$1"
  {
    printf '%s\n' "$summary"
    if [ -s "$LAST_MESSAGE_FILE" ]; then
      printf '\nCodex last message:\n'
      cat "$LAST_MESSAGE_FILE"
    else
      printf '\nCodex last message: (none)\n'
    fi
  } | jq -Rs '
    if length > 8000
    then .[0:8000] + "\n…[evidence truncated at 8000 characters]"
    else .
    end
  '
}

write_return_spec() {
  local status="$1"
  local evidence="$2"
  local sha="$3"
  local destination="$4"
  if [ -n "$sha" ]; then
    jq -n --arg status "$status" --argjson evidence "$evidence" \
      --arg sha "$sha" \
      '{status:$status, evidence:$evidence, artifacts:[$sha], diff_sha256:$sha}' \
      > "$destination"
  else
    jq -n --arg status "$status" --argjson evidence "$evidence" \
      '{status:$status, evidence:$evidence, artifacts:[]}' \
      > "$destination"
  fi
}

emergency_failed_return() {
  local evidence emergency_spec
  emergency_spec="$STATE_DIR/emergency-return.json"
  evidence="$(evidence_json "$FAILURE_REASON")" || {
    echo "buzz-runner: could not build emergency failure evidence" >&2
    return 1
  }
  write_return_spec "failed" "$evidence" "$DIFF_SHA" "$emergency_spec" || {
    echo "buzz-runner: could not build emergency failed-return spec" >&2
    return 1
  }
  if "$BUZZ_CTX_BIN" handoff return "$OPEN_EVENT_ID" "$emergency_spec"; then
    RETURN_POSTED=1
    echo "buzz-runner: posted failed return from exit guard" >&2
    return 0
  fi
  echo "buzz-runner: CRITICAL: failed to post the exit-guard handoff:return" >&2
  return 1
}

on_exit() {
  local exit_status="$?"
  trap - EXIT HUP INT TERM
  set +e
  if [ "$CLAIM_MAY_EXIST" -eq 1 ] && [ "$RETURN_POSTED" -eq 0 ]; then
    [ "$exit_status" -ne 0 ] || exit_status=1
    emergency_failed_return || true
  fi
  cleanup_state
  cleanup_preclaim_worktree
  report_worktree
  exit "$exit_status"
}
trap on_exit EXIT
trap 'FAILURE_REASON="runner interrupted by SIGHUP after claim"; exit 129' HUP
trap 'FAILURE_REASON="runner interrupted by SIGINT after claim"; exit 130' INT
trap 'FAILURE_REASON="runner interrupted by SIGTERM after claim"; exit 143' TERM

mkdir -p "$REPOSITORY_HOME/.claude/worktrees" \
  || die "could not create the runner worktree parent directory"
git -C "$SOURCE_ROOT" worktree add --detach "$WORKTREE_PATH" "$RESOLVED_COMMIT" \
  >/dev/null || die "could not create runner worktree at $WORKTREE_PATH"
WORKTREE_CREATED=1

case "$ISOLATION" in
  host)
    die "unattended host execution is disabled; use a manually supervised checkout or --dry-run"
    ;;
  podman)
    die "unattended execution remains disabled until relay-enforced exclusive claims exist; Podman contract may be inspected with --dry-run"
    ;;
esac

[ ! -e "$WORKTREE_PATH/HANDOFF.md" ] \
  || die "base worktree already contains HANDOFF.md; refusing to overwrite it"
{
  printf '# Generated journal handoff\n\n'
  printf 'This file was generated by `buzz-runner` from handoff event `%s`.\n' \
    "$OPEN_EVENT_ID"
  printf 'It is execution context only: do not edit or commit it.\n\n'
  printf '## Scope boundary\n\n%s\n\n' "$SCOPE"
  printf '## Acceptance\n\n%s\n\n' "$ACCEPTANCE"
  printf '## Authoritative event content\n\n```json\n'
  printf '%s' "$HANDOFF_SPEC" | jq .
  printf '```\n'
} > "$WORKTREE_PATH/HANDOFF.md" \
  || die "could not materialize HANDOFF.md in the runner worktree"

mkdir "$WORKTREE_PATH/handoff-artifacts" \
  || die "could not create handoff-artifacts in the runner worktree"
while IFS= read -r artifact_sha; do
  [ -n "$artifact_sha" ] || continue
  "$BUZZ_CTX_BIN" fetch "$artifact_sha" \
    "$WORKTREE_PATH/handoff-artifacts/$artifact_sha" \
    || die "failed to fetch handoff artifact $artifact_sha"
done < <(printf '%s' "$ARTIFACTS" | jq -r '.[]')

STATE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/buzz-runner.XXXXXX")" \
  || die "could not create runner state directory"
PROMPT_FILE="$STATE_DIR/prompt.txt"
LAST_MESSAGE_FILE="$STATE_DIR/last-message.txt"
RETURN_SPEC_FILE="$STATE_DIR/return.json"
TEMP_INDEX_FILE="$STATE_DIR/index"

{
  printf 'Execute journal handoff %s in this isolated worktree.\n\n' \
    "$OPEN_EVENT_ID"
  printf 'Read HANDOFF.md first; it contains the generated preamble and authoritative event content.\n'
  printf 'Treat this scope boundary as authoritative:\n%s\n\n' "$SCOPE"
  printf 'Acceptance requirement:\n%s\n\n' "$ACCEPTANCE"
  printf 'Work only inside this worktree. Do not modify HANDOFF.md or handoff-artifacts/.\n'
  printf 'Do not commit, merge, or alter any other worktree. Leave all implementation changes uncommitted for the orchestrator.\n'
} > "$PROMPT_FILE" || die "could not write the codex execution prompt"
CODEX_PROMPT="$(cat "$PROMPT_FILE")" \
  || die "could not read the codex execution prompt"

FAILURE_REASON="handoff claim command failed; claim acceptance is unknown"
CLAIM_MAY_EXIST=1
if [ "$CLAIM_NEEDED" -eq 1 ]; then
  "$BUZZ_CTX_BIN" handoff claim "$OPEN_EVENT_ID" \
    "$ISOLATION worktree $WORKTREE_PATH at $RESOLVED_COMMIT" \
    || die "handoff claim failed"
fi
FAILURE_REASON="unexpected failure after the handoff was claimed"

set +e
(
  cd "$WORKTREE_PATH" || exit 125
  env -i PATH="/usr/bin:/bin:/usr/sbin:/sbin" LANG="C.UTF-8" \
    codex exec --skip-git-repo-check --sandbox workspace-write \
      --output-last-message "$LAST_MESSAGE_FILE" "$CODEX_PROMPT" < /dev/null
)
CODEX_STATUS="$?"
set -e

if [ "$CODEX_STATUS" -eq 0 ] && [ -s "$LAST_MESSAGE_FILE" ]; then
  RETURN_STATUS="done"
  OUTCOME_SUMMARY="codex exec completed successfully."
elif [ "$CODEX_STATUS" -eq 0 ]; then
  RETURN_STATUS="failed"
  OUTCOME_SUMMARY="codex exec exited successfully but produced no last-message evidence."
else
  RETURN_STATUS="failed"
  OUTCOME_SUMMARY="codex exec exited with status $CODEX_STATUS."
fi

make_result_diff() {
  rm -f -- "$TEMP_INDEX_FILE" || return 1
  GIT_INDEX_FILE="$TEMP_INDEX_FILE" \
    git -C "$WORKTREE_PATH" read-tree HEAD || return 1
  GIT_INDEX_FILE="$TEMP_INDEX_FILE" \
    git -C "$WORKTREE_PATH" add -A -- . \
      ':(exclude)HANDOFF.md' \
      ':(exclude)handoff-artifacts' \
      ':(exclude)handoff-artifacts/**' \
      ':(exclude)result.diff' || return 1
  GIT_INDEX_FILE="$TEMP_INDEX_FILE" \
    git -C "$WORKTREE_PATH" diff --cached --binary --no-ext-diff HEAD -- \
      > "$WORKTREE_PATH/result.diff" || return 1
}

FAILURE_REASON="failed to capture the worktree git diff after claim"
if ! make_result_diff; then
  RETURN_STATUS="failed"
  OUTCOME_SUMMARY="$FAILURE_REASON"
else
  FAILURE_REASON="failed to announce the result diff after claim"
  set +e
  ANNOUNCE_OUTPUT="$("$BUZZ_CTX_BIN" announce "$WORKTREE_PATH/result.diff" \
    "handoff $EVENT_PREFIX result diff ($RETURN_STATUS)")"
  ANNOUNCE_STATUS="$?"
  set -e
  if [ "$ANNOUNCE_STATUS" -ne 0 ]; then
    RETURN_STATUS="failed"
    OUTCOME_SUMMARY="$FAILURE_REASON"
  else
    DIFF_SHA="$(printf '%s\n' "$ANNOUNCE_OUTPUT" \
      | sed -n 's/^sha256: //p' | head -n 1)"
    if ! [[ "$DIFF_SHA" =~ ^[0-9a-fA-F]{64}$ ]]; then
      DIFF_SHA=""
      RETURN_STATUS="failed"
      OUTCOME_SUMMARY="buzz-ctx announce returned no valid diff sha256 after claim."
    fi
  fi
fi

EVIDENCE="$(evidence_json "$OUTCOME_SUMMARY")" \
  || die "could not build handoff return evidence"
write_return_spec "$RETURN_STATUS" "$EVIDENCE" "$DIFF_SHA" \
  "$RETURN_SPEC_FILE" || die "could not build handoff return spec"

FAILURE_REASON="handoff return command failed; return acceptance is unknown"
"$BUZZ_CTX_BIN" handoff return "$OPEN_EVENT_ID" "$RETURN_SPEC_FILE" \
  || die "handoff return failed"
RETURN_POSTED=1

report_worktree
if [ "$RETURN_STATUS" = "done" ]; then
  exit 0
fi
exit 1
