#!/usr/bin/env bash
# buzz-ctx — identity-bound context on the sovereign relay.
#
# Context heads are NIP-AE engrams (kind 30174): NIP-44 encrypted, HMAC-
# addressed, last-write-wins per slug via addressable replacement. Session
# records are append-only kind-1 events tagged for agent/project/machine.
# Writes go to the local sovereign node; reads prefer local and fall back to
# the Cloudflare replica, so context resolves from any environment.
#
# Usage:
#   buzz-ctx save <scope> [file]        # head from file or stdin
#   buzz-ctx load <scope>               # print current head content
#   buzz-ctx ls                         # list context heads
#   buzz-ctx log <project> <message>    # append a session record
#   buzz-ctx sessions <project> [n]     # recent session records (default 10)
#   buzz-ctx sync                       # push journal to the cloud replica
#   buzz-ctx bind-agent <name> [days]   # mint an agent key + NIP-OA binding
#   buzz-ctx artifact <file>            # store an immutable content-addressed blob
#   buzz-ctx fetch <sha256> [out]       # fetch + verify an artifact
#   buzz-ctx agreement export <stream> <reader-pubkey>...  # declare (offer)
#   buzz-ctx agreement admit <source> <principal> <pubkey>...  # sink trust half
#   buzz-ctx agreement read <stream> <principal> <pubkey>...   # reader grant
#   buzz-ctx agreement steward <principal> <steward-pubkey>    # observe+report role
#   buzz-ctx agreement match <stream>   # evaluate the matched-pair rule
#   buzz-ctx agreement list             # all declaration heads
#   buzz-ctx agreement migrate          # sweep config files into declarations
#   buzz-ctx status [node-label]        # per-node governance view of the journal
#   buzz-ctx share <file|-> | -m <msg>  # post to the shared tooling/proposal space
#
# Environment (defaults for the sovereign laptop):
#   BUZZ_CTX_HOME   ~/.buzz-local
#   BUZZ_CTX_LOCAL  http://127.0.0.1:7777
#   BUZZ_CTX_CLOUD  https://buzz-portable-relay.ted-slusser-a00.workers.dev
#   BUZZ_CTX_AGENT  agent label for attribution (default: unattributed)
set -euo pipefail

HOME_DIR="${BUZZ_CTX_HOME:-$HOME/.buzz-local}"
LOCAL_URL="${BUZZ_CTX_LOCAL:-http://127.0.0.1:7777}"
CLOUD_URL="${BUZZ_CTX_CLOUD:-https://buzz-portable-relay.ted-slusser-a00.workers.dev}"
AGENT="${BUZZ_CTX_AGENT:-unattributed}"
CLIENT="$HOME_DIR/bin/sovereign-client"
KEY="$HOME_DIR/node.key"
MACHINE="$(hostname -s)"

die() { echo "buzz-ctx: $*" >&2; exit 1; }
[ -x "$CLIENT" ] || die "missing client at $CLIENT"
[ -f "$KEY" ] || die "missing node key at $KEY"
PUBKEY="$("$CLIENT" pubkey "$KEY")"

relay_for_write() {
  curl -sf --max-time 2 "$LOCAL_URL/health" >/dev/null || die "local sovereign node is not reachable at $LOCAL_URL (writes go to the source of truth; start it or set BUZZ_CTX_LOCAL)"
  echo "$LOCAL_URL"
}

relay_for_read() {
  if curl -sf --max-time 2 "$LOCAL_URL/health" >/dev/null; then
    echo "$LOCAL_URL"
  else
    echo "cloud fallback: local node unreachable, reading $CLOUD_URL" >&2
    echo "$CLOUD_URL"
  fi
}

post_event() { # $1 = unsigned event JSON
  local relay tmp
  relay="$(relay_for_write)"
  tmp="$(mktemp)"
  printf '%s' "$1" > "$tmp"
  "$CLIENT" post "$KEY" "$relay" "$tmp" >/dev/null
  rm -f "$tmp"
}

case "${1:-}" in
  save)
    # Context heads are NIP-AE engrams (kind 30174): NIP-44 encrypted,
    # slug-addressed via HMAC d tags, written with upstream buzz-cli.
    scope="${2:?usage: buzz-ctx save <scope> [file]}"
    relay="$(relay_for_write)"
    cat "${3:-/dev/stdin}" | BUZZ_RELAY_URL="$relay" BUZZ_PRIVATE_KEY="$(cat "$KEY")" \
      "$HOME_DIR/bin/buzz" mem set "mem/ctx/$scope" - --owner "$PUBKEY"
    echo "saved encrypted head mem/ctx/$scope as $AGENT@$MACHINE"
    ;;
  load)
    scope="${2:?usage: buzz-ctx load <scope>}"
    relay="$(relay_for_read)"
    BUZZ_RELAY_URL="$relay" BUZZ_PRIVATE_KEY="$(cat "$KEY")" \
      "$HOME_DIR/bin/buzz" mem get "mem/ctx/$scope" --owner "$PUBKEY" \
      || die "no head found for mem/ctx/$scope"
    echo
    ;;
  ls)
    relay="$(relay_for_read)"
    BUZZ_RELAY_URL="$relay" BUZZ_PRIVATE_KEY="$(cat "$KEY")" \
      "$HOME_DIR/bin/buzz" mem ls --owner "$PUBKEY"
    ;;
  artifact)
    file="${2:?usage: buzz-ctx artifact <file>}"
    relay="$(relay_for_write)"
    "$CLIENT" upload "$KEY" "$relay" "$file" | sed 's/^200 //' | jq -r '"stored artifact " + .sha256 + " (" + (.size|tostring) + " bytes) — reference with tag [\"x\",\"" + .sha256 + "\"]"'
    ;;
  fetch)
    sha="${2:?usage: buzz-ctx fetch <sha256> [out]}"
    relay="$(relay_for_read)"
    "$CLIENT" fetch "$KEY" "$relay" "$sha" ${3:+"$3"}
    ;;
  agreement)
    # Sync declarations per sovereign-sync-agreement-v0.1-draft.
    # Kind 30700 is PROVISIONAL pending upstream registry assignment.
    AGREEMENT_KIND=30700
    # Declarations that govern a node's config are node-scoped via an n tag;
    # BUZZ_CTX_NODE names the governed node (default: this laptop's label).
    NODE_LABEL="${BUZZ_CTX_NODE:-ted-laptop}"
    sub="${2:?usage: buzz-ctx agreement export|match|list ...}"
    case "$sub" in
      export)
        stream="${3:?usage: buzz-ctx agreement export <stream> <reader-pubkey>...}"
        shift 3
        [ $# -ge 1 ] || die "at least one reader/destination pubkey required"
        selection="$(jq -e --arg s "$stream" '.[$s]' "$HOME_DIR/streams.json")"           || die "stream $stream not declared in streams.json"
        readers="$(printf '%s\n' "$@" | jq -R . | jq -sc 'map(["p", .])')"
        event="$(jq -n --arg pk "$PUBKEY" --arg d "export/$stream" \
          --arg n "$NODE_LABEL" \
          --argjson sel "$selection" --argjson readers "$readers" \
          --arg ts "$(date +%s)" \
          '{pubkey:$pk, created_at:($ts|tonumber), kind:30700,
            tags:([["d",$d],["n",$n]] + $readers),
            content:({status:"active", selection:$sel, artifacts:"referenced"}|tojson)}')"
        post_event "$event"
        echo "declared export/$stream on node $NODE_LABEL (offer to: $*)"
        ;;
      admit)
        # Destination-side half: which principal, under which verification
        # keys, may push this source stream into our sink. Owner-signed admit
        # heads govern the relay's peer trust wholesale (runtime evaluation
        # policy); peer-trust.json becomes bootstrap-only.
        source_id="${3:?usage: buzz-ctx agreement admit <source> <principal> <verification-pubkey>...}"
        principal="${4:?a stable principal label (e.g. did:buzz:node-c) is required}"
        shift 4
        [ $# -ge 1 ] || die "at least one verification pubkey required"
        keys="$(printf '%s\n' "$@" | jq -R . | jq -sc 'map(["p", .])')"
        event="$(jq -n --arg pk "$PUBKEY" --arg d "admit/$source_id" \
          --arg n "$NODE_LABEL" \
          --arg principal "$principal" --argjson keys "$keys" \
          --arg ts "$(date +%s)" \
          '{pubkey:$pk, created_at:($ts|tonumber), kind:30700,
            tags:([["d",$d],["n",$n]] + $keys),
            content:({status:"active", principal:$principal,
                      retention:{keep:"journal"}}|tojson)}')"
        post_event "$event"
        echo "declared admit/$source_id on node $NODE_LABEL (principal $principal, $# key(s))"
        ;;
      read)
        # Source-side reader grant: which principal may drain this exported
        # stream from the governed node (the rendezvous-reader role).
        stream="${3:?usage: buzz-ctx agreement read <stream> <principal> <reader-pubkey>...}"
        principal="${4:?a stable principal label (e.g. did:buzz:node-c) is required}"
        shift 4
        [ $# -ge 1 ] || die "at least one reader pubkey required"
        keys="$(printf '%s\n' "$@" | jq -R . | jq -sc 'map(["p", .])')"
        event="$(jq -n --arg pk "$PUBKEY" --arg d "read/$stream" \
          --arg n "$NODE_LABEL" \
          --arg principal "$principal" --argjson keys "$keys" \
          --arg ts "$(date +%s)" \
          '{pubkey:$pk, created_at:($ts|tonumber), kind:30700,
            tags:([["d",$d],["n",$n]] + $keys),
            content:({status:"active", principal:$principal}|tojson)}')"
        post_event "$event"
        echo "declared read/$stream on node $NODE_LABEL (principal $principal, $# key(s))"
        ;;
      migrate)
        # Sweep bootstrap config files into owner-signed declarations, per
        # "Mapping from current operator configuration" in the draft spec.
        # Idempotent: sources already declared are reported, not re-minted.
        relay="$(relay_for_read)"
        heads="$("$CLIENT" query "$KEY" "$relay" \
          "[{\"kinds\":[30700],\"authors\":[\"$PUBKEY\"]}]" | sed 's/^200 //')"
        if [ -f "$HOME_DIR/peer-trust.json" ]; then
          while IFS=$'\t' read -r source_id principal keys_csv; do
            if printf '%s' "$heads" | jq -e --arg d "admit/$source_id" \
              '[.[] | select(any(.tags[]; .[0]=="d" and .[1]==$d))] | length > 0' >/dev/null; then
              echo "admit/$source_id: already declared — journal governs"
            else
              # shellcheck disable=SC2046
              "$0" agreement admit "$source_id" "$principal" $(echo "$keys_csv" | tr ',' ' ')
            fi
          done < <(jq -r 'to_entries[] |
            [.key, .value.principal, (.value.verification_keys|join(","))] | @tsv' \
            "$HOME_DIR/peer-trust.json")
        else
          echo "no peer-trust.json — admit domain has nothing to migrate"
        fi
        if [ -f "$HOME_DIR/streams.json" ]; then
          for stream in $(jq -r 'keys[]' "$HOME_DIR/streams.json"); do
            if printf '%s' "$heads" | jq -e --arg d "export/$stream" \
              '[.[] | select(any(.tags[]; .[0]=="d" and .[1]==$d))] | length > 0' >/dev/null; then
              echo "export/$stream: already declared — journal governs"
            else
              echo "export/$stream: MISSING — mint with: buzz-ctx agreement export $stream <reader-pubkey>..."
            fi
          done
        fi
        ;;
      steward)
        # Operational role grant: observe + report ONLY, per the steward
        # role in the draft spec. Confers no config authority and no key
        # custody; scoped to the node named by BUZZ_CTX_NODE.
        principal="${3:?usage: buzz-ctx agreement steward <principal> <steward-pubkey>}"
        steward_pk="${4:?steward agent pubkey required}"
        event="$(jq -n --arg pk "$PUBKEY" --arg d "steward/$NODE_LABEL" \
          --arg n "$NODE_LABEL" --arg principal "$principal" \
          --arg steward "$steward_pk" --arg ts "$(date +%s)" \
          '{pubkey:$pk, created_at:($ts|tonumber), kind:30700,
            tags:[["d",$d],["n",$n],["p",$steward],["h","shared/steward-reports"]],
            content:({status:"active", principal:$principal,
                      powers:["observe","report"]}|tojson)}')"
        post_event "$event"
        echo "declared steward/$NODE_LABEL (principal $principal, observe+report)"
        ;;
      match)
        stream="${3:?usage: buzz-ctx agreement match <stream>}"
        relay="$(relay_for_read)"
        heads="$("$CLIENT" query "$KEY" "$relay" \
          "[{\"kinds\":[30700],\"#d\":[\"export/$stream\",\"admit/$stream\"]}]" \
          | sed 's/^200 //')"
        printf '%s' "$heads" | jq -r --arg me "$PUBKEY" --arg s "$stream" '
          def dtag(e): e.tags[] | select(.[0]=="d") | .[1];
          def status(e): (e.content | fromjson).status // "active";
          [.[] | select(dtag(.) == ("export/" + $s))] as $exports |
          [.[] | select(dtag(.) == ("admit/" + $s))] as $admits |
          if ($exports | length) == 0 then "UNMATCHED: no export declaration for \($s)"
          elif ($admits | length) == 0 then
            "OFFER OPEN: export by \($exports[0].pubkey[0:12])… (event \($exports[0].id[0:12])…), no admit half yet"
          else
            $exports[0] as $e | $admits[0] as $a |
            ($a.tags[] | select(.[0]=="e") | .[1]) as $pin |
            (if status($e) != "active" then "UNMATCHED: export status \(status($e))"
             elif status($a) != "active" then "UNMATCHED: admit status \(status($a))"
             elif $pin != $e.id then
               "DRIFT: admit by \($a.pubkey[0:12])… pins \($pin[0:12])… but export head is \($e.id[0:12])… — re-pin required"
             elif ([$e.tags[] | select(.[0]=="p") | .[1]] | index($a.pubkey)) == null then
               "UNMATCHED: admit author \($a.pubkey[0:12])… is not an offered party on the export"
             else
               "MATCHED: \($s) — export \($e.id[0:12])… (\($e.pubkey[0:12])…) ⇄ admit \($a.id[0:12])… (\($a.pubkey[0:12])…)"
             end)
          end'
        ;;
      list)
        relay="$(relay_for_read)"
        "$CLIENT" query "$KEY" "$relay" '[{"kinds":[30700]}]' | sed 's/^200 //' \
          | jq -r '.[] | (.tags[] | select(.[0]=="d") | .[1]) + "  " + ((.content|fromjson).status // "?") + "  by " + .pubkey[0:12] + "…  event " + .id[0:12] + "…"' \
          | sort
        ;;
      *) die "unknown agreement subcommand: $sub" ;;
    esac
    ;;
  status)
    # Perspective viewer: one journal, one lens per node. Renders each
    # governed node's effective configuration by evaluating declaration
    # heads under the SAME policy the adapters run (owner-signed, n-tagged,
    # active-confers, per-domain wholesale). What this shows is what the
    # nodes enforce — it is also the read-only steward's future sensor.
    only="${2:-}"
    relay="$(relay_for_read)"
    heads="$("$CLIENT" query "$KEY" "$relay" '[{"kinds":[30700]}]' | sed 's/^200 //')"
    printf '%s' "$heads" | jq -r --arg me "$PUBKEY" --arg only "$only" '
      def tag(e; k): [e.tags[] | select(.[0]==k) | .[1]][0];
      def st(e): ((e.content | fromjson).status // "active");
      def dtag(e): tag(e; "d");
      def ntag(e): tag(e; "n");
      def role(e): dtag(e) | split("/")[0];
      def stream(e): dtag(e) as $d | $d | ltrimstr(($d | split("/")[0]) + "/");
      def pcount(e): [e.tags[] | select(.[0]=="p")] | length;
      def principal(e): ((e.content | fromjson).principal // "-");
      def sel(e): ((e.content | fromjson).selection // null)
        | if . == null then "-"
          elif .mirror == true then "mirror"
          elif .filter then "filter"
          elif .from_source then "from_source=\(.from_source)"
          else "?" end;
      [.[] | select(.pubkey == $me and dtag(.) != null)] as $mine
      | [.[] | select(.pubkey != $me and dtag(.) != null)] as $foreign
      | ([$mine[] | ntag(.) // empty] | unique) as $nodes
      | (if $only == "" then $nodes else [$only] end) as $show
      | (
          $show[] as $node
          | "■ node \($node)",
            ( ["admit","read","export"][] as $r
              | [$mine[] | select(ntag(.) == $node and role(.) == $r)] as $hs
              | [$hs[] | select(st(.) == "active")] as $act
              | ( if ($hs | length) == 0
                  then "  \($r): unclaimed — bootstrap file/env governs"
                  else "  \($r): journal-governed (\($act | length) active / \($hs | length) heads)"
                  end ),
                ( $act[]
                  | if role(.) == "export"
                    then "    \(stream(.))  [\(sel(.))]  offered to \(pcount(.)) key(s)"
                    else "    \(stream(.))  \(principal(.))  \(pcount(.)) key(s)"
                    end )
            ),
            ""
        ),
        ( [$mine[] | select(ntag(.) == null)]
          | if length == 0 then empty else
              "■ unscoped heads (govern no node)",
              (.[] | "  \(dtag(.))  \(st(.))"), "" end ),
        ( $foreign
          | if length == 0 then empty else
              "■ foreign halves (relationship state, never config)",
              (.[] | "  \(dtag(.))  \(st(.))  by \(.pubkey[0:12])…") end )
    '
    ;;
  share)
    # Shared tooling/proposal space: plaintext kind-1 events tagged
    # shared:tooling, drained by peer nodes through the cf-rendezvous
    # shared/tooling stream. Plaintext by design — scripts and proposals,
    # never secrets or personal context (compartments exist for that).
    src="${2:?usage: buzz-ctx share <file|-> | buzz-ctx share -m <message>}"
    if [ "$src" = "-m" ]; then
      content="${3:?message required after -m}"
    elif [ "$src" = "-" ]; then
      content="$(cat)"
    else
      content="$(cat "$src")"
    fi
    signer_key="$KEY"
    signer_pub="$PUBKEY"
    auth_tag="null"
    if [ -f "$HOME_DIR/agents/$AGENT.key" ]; then
      signer_key="$HOME_DIR/agents/$AGENT.key"
      signer_pub="$("$CLIENT" pubkey "$signer_key")"
      auth_tag="$(cat "$HOME_DIR/agents/$AGENT.auth" 2>/dev/null || echo null)"
    fi
    event="$(jq -n --arg pk "$signer_pub" --arg c "$content" \
      --arg agent "$AGENT" --arg machine "$MACHINE" --arg ts "$(date +%s)" \
      --argjson auth "$auth_tag" \
      '{pubkey:$pk, created_at:($ts|tonumber), kind:1,
        tags:([["t","shared:tooling"],["agent",$agent],["machine",$machine]]
              + (if $auth == null then [] else [$auth] end)),
        content:$c}')"
    relay="$(relay_for_write)"
    tmp="$(mktemp)"; printf '%s' "$event" > "$tmp"
    "$CLIENT" post "$signer_key" "$relay" "$tmp" >/dev/null; rm -f "$tmp"
    echo "shared to tooling space as $AGENT@$MACHINE ($(printf '%s' "$content" | wc -c | tr -d ' ') bytes)"
    ;;
  bind-agent)
    # Session binding v1: the agent gets its own key; the node (owner) key
    # signs a time-bounded NIP-OA capability. Agent events stay authored by
    # the agent key — attribution becomes a signature, not a claimed tag.
    name="${2:?usage: buzz-ctx bind-agent <name> [days]}"
    days="${3:-30}"
    mkdir -p "$HOME_DIR/agents"
    agent_key="$HOME_DIR/agents/$name.key"
    [ -f "$agent_key" ] && die "agent $name already bound (key exists); remove $agent_key first to rebind"
    agent_pub="$("$CLIENT" keygen "$agent_key")"
    chmod 600 "$agent_key"
    expiry=$(( $(date +%s) + days * 86400 ))
    "$CLIENT" mint-auth "$KEY" "$agent_pub" "created_at<$expiry" > "$HOME_DIR/agents/$name.auth"
    echo "bound agent $name ($agent_pub), capability expires $(date -r $expiry '+%Y-%m-%d')"
    ;;
  log)
    project="${2:?usage: buzz-ctx log <project> <message>}"
    message="${3:?usage: buzz-ctx log <project> <message>}"
    signer_key="$KEY"
    signer_pub="$PUBKEY"
    auth_tag="null"
    if [ -f "$HOME_DIR/agents/$AGENT.key" ]; then
      signer_key="$HOME_DIR/agents/$AGENT.key"
      signer_pub="$("$CLIENT" pubkey "$signer_key")"
      auth_tag="$(cat "$HOME_DIR/agents/$AGENT.auth" 2>/dev/null || echo null)"
    fi
    event="$(jq -n --arg pk "$signer_pub" --arg c "$message" --arg p "$project" \
      --arg agent "$AGENT" --arg machine "$MACHINE" --arg ts "$(date +%s)" \
      --argjson auth "$auth_tag" \
      '{pubkey:$pk, created_at:($ts|tonumber), kind:1,
        tags:([["t","session:\($p)"],["agent",$agent],["machine",$machine]]
              + (if $auth == null then [] else [$auth] end)),
        content:$c}')"
    relay="$(relay_for_write)"
    tmp="$(mktemp)"; printf '%s' "$event" > "$tmp"
    "$CLIENT" post "$signer_key" "$relay" "$tmp" >/dev/null; rm -f "$tmp"
    if [ "$auth_tag" != "null" ]; then
      echo "logged session record for $project as $AGENT@$MACHINE (agent-signed, owner-attested)"
    else
      echo "logged session record for $project as $AGENT@$MACHINE (node-signed)"
    fi
    ;;
  sessions)
    project="${2:?usage: buzz-ctx sessions <project> [n]}"
    limit="${3:-10}"
    relay="$(relay_for_read)"
    result="$("$CLIENT" query "$KEY" "$relay" \
      "[{\"kinds\":[1],\"#t\":[\"session:$project\"],\"limit\":$limit}]")"
    printf '%s' "$result" | sed 's/^200 //' | jq -r \
      '.[] | "\(.created_at | todate)  [\((.tags[]|select(.[0]=="agent"))[1] // "?")@\((.tags[]|select(.[0]=="machine"))[1] // "?")\(if any(.tags[]; .[0]=="auth") then " ✓" else "" end)]  \(.content)"'
    ;;
  sync)
    exec "$HOME_DIR/bin/buzz-relay-push" \
      --data "$HOME_DIR/sovereign.ndjson" \
      --to "$CLOUD_URL" \
      --source ted-laptop/sovereign \
      --key "$KEY"
    ;;
  *)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
