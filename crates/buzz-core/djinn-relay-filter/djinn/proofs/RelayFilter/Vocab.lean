/-  Vocab.lean — generated by `cargo djinn`; part of the trusted driver.
    The views the specification uses for strings and maps, the helpers the
    trusted models of `String` and `HashMap` are built from, and lemmas about
    the vocabulary's Lean models (`l[i]!` with `i : ℤ` cast through `.toNat`,
    `.set`, lengths, counts). `Proofs.lean` imports this file and opens
    `Djinn.Vocab`. A module, so that the model files may import it. -/
module
public import Aeneas
@[expose] public section
open Aeneas Std Result
set_option linter.dupNamespace false
set_option linter.unusedVariables false

namespace Djinn.Vocab

/-- The bytes of a Rust `String`: its UTF-8 encoding. This is the view the
    specification gives a `String`, the same as a `&str`'s. -/
def bytes (s : String) : List U8 :=
  s.toUTF8.toList.map (fun b => U8.ofNatCore b.toNat (by have := b.toNat_lt; simp [UScalarTy.numBits]; omega))

/-- A string from bytes, when they are valid UTF-8. -/
def ofBytes (l : List U8) : Option String :=
  String.fromUTF8? ⟨(l.map (fun b => UInt8.ofNat b.val)).toArray⟩

/-- `m.get(&k)` in a specification: the value at the first entry with key `k`. -/
def mapGet {K V : Type} [DecidableEq K] (l : List (K × V)) (k : K) : Option V :=
  (l.find? (fun p => p.1 = k)).map (·.2)

/-- Lookup through Rust's `Borrow` and `Eq` instances (the models of
    `HashMap::get`, `contains_key`, `insert`, `remove` use it). -/
def find {K V Q : Type} (borrow : K → Result Q) (eq : Q → Q → Result Bool) :
    List (K × V) → Q → Result (Option (K × V))
  | [], _ => ok none
  | (k, v) :: rest, q => do
    let kq ← borrow k
    let b ← eq kq q
    if b then ok (some (k, v)) else find borrow eq rest q

/-- Replace the value of the first entry whose key equals `k`. -/
def replace {K V : Type} (eq : K → K → Result Bool) : List (K × V) → K → V → Result (List (K × V))
  | [], _, _ => ok []
  | (k', v') :: rest, k, v => do
    let b ← eq k' k
    if b then ok ((k', v) :: rest) else do
      let r ← replace eq rest k v
      ok ((k', v') :: r)

/-- Drop the first entry whose borrowed key equals the query. -/
def erase {K V Q : Type} (borrow : K → Result Q) (eq : Q → Q → Result Bool) :
    List (K × V) → Q → Result (List (K × V))
  | [], _ => ok []
  | (k', v') :: rest, q => do
    let kq ← borrow k'
    let b ← eq kq q
    if b then ok rest else do
      let r ← erase borrow eq rest q
      ok ((k', v') :: r)

/-- The byte view of a string has the string's byte size. -/
@[simp] theorem length_bytes (s : String) : (bytes s).length = s.utf8ByteSize := by
  simp [bytes, ByteArray.length_toList]

/-- `find` through the identity borrow and a decidable-equality `eq` (the
    scalar instances: `core.cmp.EqU32.partialEqInst.eq a b = ok (decide (a = b))`
    by `rfl`) is `find?` on the key; this bridges the models of `get`,
    `contains_key` and `remove` to `mapGet`. -/
theorem find_eq {K V : Type} [DecidableEq K] (borrow : K → Result K) (eq : K → K → Result Bool)
    (hb : ∀ x, borrow x = ok x) (heq : ∀ a b, eq a b = ok (decide (a = b))) (l : List (K × V)) (k : K) :
    find borrow eq l k = ok (l.find? (fun p => p.1 = k)) := by
  induction l with
  | nil => rfl
  | cons p rest ih =>
    obtain ⟨k', v'⟩ := p
    simp only [find, hb, heq, List.find?]
    by_cases h : k' = k
    · subst h; simp
    · simp [h, ih]

/-- `l[k]!` as the proof-carrying access, when `k` is in range. -/
theorem val_getElem! {α : Type} [Inhabited α] (l : List α) (k : Nat) (hk : k < l.length) :
    l[k]! = l[k]'hk := by
  rw [getElem!_pos l k hk]

/-- Reading after two writes. -/
theorem getElem!_set_set {α : Type} [Inhabited α] (l : List α) (i j k : Nat) (x y : α) (hk : k < l.length) :
    ((l.set i x).set j y)[k]! = if k = j then y else if k = i then x else l[k]! := by
  have hk1 : k < ((l.set i x).set j y).length := by simpa
  rw [getElem!_pos _ k hk1, getElem!_pos l k hk]
  split_ifs with h1 h2
  · subst h1; simp
  · subst h2; rw [List.getElem_set_ne (Ne.symm h1)]; simp
  · rw [List.getElem_set_ne (Ne.symm h1), List.getElem_set_ne (Ne.symm h2)]

/-- Reading after one write. -/
theorem getElem!_set {α : Type} [Inhabited α] (l : List α) (i k : Nat) (x : α) (hk : k < l.length) :
    (l.set i x)[k]! = if k = i then x else l[k]! := by
  have hk1 : k < (l.set i x).length := by simpa
  rw [getElem!_pos _ k hk1, getElem!_pos l k hk]
  split_ifs with h1
  · subst h1; simp
  · rw [List.getElem_set_ne (Ne.symm h1)]

/-- An index written as a natural number cast to `ℤ` and back. -/
@[simp] theorem toNat_natCast_int (n : Nat) : ((n : ℤ)).toNat = n := Int.toNat_natCast n

/-- Membership through an in-range index. -/
theorem getElem!_mem {α : Type} [Inhabited α] (l : List α) (k : Nat) (hk : k < l.length) : l[k]! ∈ l := by
  rw [getElem!_pos l k hk]
  exact List.getElem_mem hk

/-- `List.count` is bounded by the length. -/
theorem count_le_length' {α : Type} [BEq α] (a : α) (l : List α) : l.count a ≤ l.length :=
  List.count_le_length

/-! ## The `memchr` crate: first and last index of a byte -/

/-- The first index of `n` in `l`, if any: the model of `memchr::memchr`. -/
def memchr (n : U8) (l : List U8) : Option Nat := l.findIdx? (· == n)

/-- The last index of `n` in `l`, if any: the model of `memchr::memrchr`. -/
def memrchr (n : U8) (l : List U8) : Option Nat :=
  (l.reverse.findIdx? (· == n)).map (fun i => l.length - 1 - i)

theorem memchr_eq_none {n : U8} {l : List U8} : memchr n l = none ↔ n ∉ l := by
  simp only [memchr, List.findIdx?_eq_none_iff, beq_eq_false_iff_ne]
  constructor
  · intro h hn; exact h n hn rfl
  · intro h x hx hxn; subst hxn; exact h hx

theorem memchr_eq_some {n : U8} {l : List U8} {i : Nat} :
    memchr n l = some i ↔ i < l.length ∧ l[i]! = n ∧ ∀ j, j < i → l[j]! ≠ n := by
  unfold memchr
  rw [List.findIdx?_eq_some_iff_findIdx_eq]
  constructor
  · rintro ⟨hi, hf⟩
    rw [List.findIdx_eq hi] at hf
    obtain ⟨h1, h2⟩ := hf
    refine ⟨hi, ?_, ?_⟩
    · rw [getElem!_pos l i hi]; simpa using h1
    · intro j hj; rw [getElem!_pos l j (by omega)]; simpa using h2 j hj
  · rintro ⟨hi, h1, h2⟩
    refine ⟨hi, ?_⟩
    rw [List.findIdx_eq hi]
    refine ⟨?_, ?_⟩
    · rw [getElem!_pos l i hi] at h1; simpa using h1
    · intro j hj; have := h2 j hj; rw [getElem!_pos l j (by omega)] at this; simpa using this

theorem memrchr_eq_none {n : U8} {l : List U8} : memrchr n l = none ↔ n ∉ l := by
  simp only [memrchr, Option.map_eq_none_iff, List.findIdx?_eq_none_iff, List.mem_reverse, beq_eq_false_iff_ne]
  constructor
  · intro h hn; exact h n hn rfl
  · intro h x hx hxn; subst hxn; exact h hx

theorem memrchr_eq_some {n : U8} {l : List U8} {i : Nat} :
    memrchr n l = some i ↔ i < l.length ∧ l[i]! = n ∧ ∀ j, i < j → j < l.length → l[j]! ≠ n := by
  unfold memrchr
  constructor
  · intro h
    rw [Option.map_eq_some_iff] at h
    obtain ⟨k, hk, hki⟩ := h
    rw [List.findIdx?_eq_some_iff_findIdx_eq] at hk
    obtain ⟨hk, hf⟩ := hk
    have hk' : k < l.length := by simpa using hk
    rw [List.findIdx_eq hk] at hf
    obtain ⟨h1, h2⟩ := hf
    rw [List.getElem_reverse] at h1
    subst hki
    refine ⟨by omega, ?_, ?_⟩
    · rw [getElem!_pos l _ (by omega)]; simpa using h1
    · intro j hij hj
      have := h2 (l.length - 1 - j) (by omega)
      rw [List.getElem_reverse, getElem_congr_idx (by omega : l.length - 1 - (l.length - 1 - j) = j)] at this
      rw [getElem!_pos l j hj]
      simpa using this
  · rintro ⟨hi, h1, h2⟩
    rw [Option.map_eq_some_iff]
    refine ⟨l.length - 1 - i, ?_, by omega⟩
    rw [List.findIdx?_eq_some_iff_findIdx_eq]
    have hlt : l.length - 1 - i < l.reverse.length := by simp; omega
    refine ⟨hlt, ?_⟩
    rw [List.findIdx_eq hlt]
    refine ⟨?_, ?_⟩
    · rw [List.getElem_reverse, getElem_congr_idx (by omega : l.length - 1 - (l.length - 1 - i) = i)]
      rw [getElem!_pos l i hi] at h1; simpa using h1
    · intro k hk
      rw [List.getElem_reverse]
      have hj := h2 (l.length - 1 - k) (by omega) (by omega)
      rw [getElem!_pos l _ (by omega)] at hj
      simpa using hj

end Djinn.Vocab
