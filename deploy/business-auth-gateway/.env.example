POSTGRES_DB=business_auth
POSTGRES_USER=business_auth
POSTGRES_PASSWORD=replace-with-a-secret
# Pre-create this NOLOGIN/LOGIN role as appropriate; migration grants only the
# table privileges required by the runtime and never grants audit UPDATE/DELETE.
BUSINESS_AUTH_RUNTIME_DATABASE_ROLE=business_auth_runtime
BUSINESS_AUTH_RUNTIME_DATABASE_PASSWORD=replace-with-a-different-secret
AUTHENTIK_ISSUER=https://auth.example.com/application/o/workbench
WORKBENCH_CLIENT_ID=bizfin-workbench
BUSINESS_CLIENT_ID=bizfin-business
ALLOWED_WORKBENCH_ORIGINS=https://workbench.example.com,tauri://localhost,http://tauri.localhost
BUSINESS_APP_ORIGIN=https://business.example.com
IDENTITY_BINDING_CHALLENGE_TTL_SECONDS=90
EMBED_SESSION_TTL_SECONDS=30
BUSINESS_SESSION_TTL_SECONDS=86400
EMBED_SESSION_RATE_LIMIT_PER_MINUTE=10
SESSION_CLEANUP_INTERVAL_SECONDS=60
BUSINESS_SESSION_COOKIE_NAME=__Host-bizfin_business
BUSINESS_SESSION_COOKIE_SECURE=true
BUSINESS_SESSION_COOKIE_SAMESITE=None
DEPLOYMENT_ID=production-eu-1
GLOBAL_LOGOUT_REDIRECT_URI=https://workbench.example.com/
