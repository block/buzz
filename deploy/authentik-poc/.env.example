# Copy to .env. Generate values locally; never commit the resulting file.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.8.0
PG_DB=authentik
PG_USER=authentik
PG_PASS=REPLACE_WITH_OPENSSL_RAND_BASE64_36
AUTHENTIK_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_60

# Create this confidential client in Authentik after first boot.
BUSINESS_OIDC_ISSUER=https://auth.bizfin.test/application/o/business/
BUSINESS_OIDC_CLIENT_ID=REPLACE_WITH_BUSINESS_CLIENT_ID
BUSINESS_OIDC_CLIENT_SECRET=REPLACE_WITH_BUSINESS_CLIENT_SECRET
BUSINESS_OIDC_REDIRECT_URI=https://business.bizfin.test/auth/callback
BUSINESS_POST_LOGOUT_REDIRECT_URI=https://business.bizfin.test/
WORKBENCH_ORIGIN=https://workbench.bizfin.test
BUSINESS_COOKIE_SECURE=true
BUSINESS_COOKIE_SAME_SITE=Lax
BUSINESS_EMBED_AUDIENCE=business-dock
BUSINESS_EMBED_CALLBACK_URI=buzz-dev://auth/business-bootstrap

# Required only with docker-compose.poc-provision.yml. Never use defaults.
POC_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_POC_ADMIN_PASSWORD
POC_USER_PASSWORD=REPLACE_WITH_RANDOM_POC_USER_PASSWORD
WORKBENCH_OIDC_CLIENT_ID=REPLACE_WITH_WORKBENCH_CLIENT_ID

COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443
BUSINESS_PORT_HTTP=3001
