[
  {
    "name": "custom_crm",
    "command": "mcp-remote",
    "args": [
      "https://mcp.example.com/mcp",
      "--header",
      "Authorization:${CRM_AUTH_HEADER}",
      "--transport",
      "http-only",
      "--ignore-tool",
      "delete*"
    ],
    "inherit_env": ["CRM_AUTH_HEADER"]
  }
]
