#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
# The repository pins Rust/Node tooling through Hermit; native review provisions
# its sole Python dependency explicitly for clean environments.
source "$REPO_ROOT/bin/activate-hermit"
exec uv run --with 'pyyaml==6.0.3' python "$SCRIPT_DIR/review_native.py" "$@"
