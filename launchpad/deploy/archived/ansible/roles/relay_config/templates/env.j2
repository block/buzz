{# Rendered ONCE, on the first run only, when {{ buzz_compose_dir }}/.env is absent.
 #
 # Never re-rendered. Subsequent runs converge the non-secret lines in place with
 # lineinfile, because re-rendering would rotate BUZZ_RELAY_PRIVATE_KEY and make
 # every event this relay ever signed unverifiable (hardening-spec.md §B8 — there
 # is no rotation path; the answer to a compromised relay key is a new community).
 #
 # Mode 0600, owned by root. Every secret in the system is in here.
-#}
# Buzz deployment environment — GENERATED ON THE TARGET by Ansible.
# Present in no tracked file (AGENTS.md rule 2, issue #22).
#
# Community host: {{ buzz_authority }}
#   Derived from RELAY_URL by relay_url_authority(); normalize_host() lowercases
#   and strips a trailing :443 or :80 and NOTHING else. There is no command that
#   seeds the communities table — this one variable decides which community
#   exists and therefore which Host headers are accepted. Get it wrong and every
#   client is refused while /health, /_liveness and NIP-11 all still return 200.

{% for key, value in buzz_env_settings | dictsort %}
{{ key }}={{ value }}
{% endfor %}
{% if buzz_max_connections | length > 0 %}
BUZZ_MAX_CONNECTIONS={{ buzz_max_connections }}
{% endif %}

# --- identities -------------------------------------------------------------
# Two SEPARATE keypairs. The owner contributes its PUBLIC half (whoever holds the
# matching secret is the administrator); the relay contributes its SECRET half.
# buzz-admin's own "Set BUZZ_PRIVATE_KEY" hint does not apply to either — there
# is no BUZZ_PRIVATE_KEY in this deployment.
RELAY_OWNER_PUBKEY={{ buzz_owner_pubkey }}
BUZZ_RELAY_PRIVATE_KEY={{ buzz_relay_secret }}

# --- generated secrets ------------------------------------------------------
BUZZ_GIT_HOOK_HMAC_SECRET={{ buzz_secrets.git_hmac }}
POSTGRES_PASSWORD={{ buzz_secrets.postgres_password }}
REDIS_PASSWORD={{ buzz_secrets.redis_password }}
# These two become MinIO's ROOT credentials as well as the relay's S3
# credentials (compose.yml: MINIO_ROOT_USER/MINIO_ROOT_PASSWORD). So the relay
# runs as MinIO's root account and a compromised relay can administer the object
# store, not merely read media. hardening-spec.md §B4 wants a scoped service
# account instead; that needs a cohort-owned extension of the minio-init step and
# is not implemented here.
BUZZ_S3_ACCESS_KEY={{ buzz_secrets.s3_access_key }}
BUZZ_S3_SECRET_KEY={{ buzz_secrets.s3_secret_key }}
