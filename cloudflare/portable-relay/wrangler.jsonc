{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buzz-portable-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  // Opt-in identity, mirroring the laptop adapter's --require-auth flag.
  // Set to "1" (or deploy with --var) to require NIP-42/NIP-98 identity.
  "vars": {
    "BUZZ_REQUIRE_AUTH": "",
    // Destination-controlled replication trust: JSON mapping a source stream
    // ID to { "principal": string, "verification_keys": [pubkey hex] }.
    // Empty means no replication peers are admitted (fail closed).
    "BUZZ_REPLICATION_PEERS": "",
    // Streams this node exports for authorized readers to drain (rendezvous
    // role): {"<source>": {"filter": null | [NIP-01 filters]}}.
    "BUZZ_REPLICATION_STREAMS": "",
    // Source-controlled reader trust for exported streams; same shape as
    // BUZZ_REPLICATION_PEERS. Empty = nothing is drainable (fail closed).
    "BUZZ_REPLICATION_READERS": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_NODES",
        "class_name": "RelayNode"
      }
    ]
  },
  "exports": {
    "RelayNode": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
