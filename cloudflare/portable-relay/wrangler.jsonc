{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buzz-portable-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  // Opt-in identity, mirroring the laptop adapter's --require-auth flag.
  // Set to "1" (or deploy with --var) to require NIP-42/NIP-98 identity.
  "vars": {
    "BUZZ_REQUIRE_AUTH": "1",
    // Destination-controlled replication trust: JSON mapping a source stream
    // ID to { "principal": string, "verification_keys": [pubkey hex] }.
    // Empty means no replication peers are admitted (fail closed).
    "BUZZ_REPLICATION_PEERS": "",
    // Streams this node exports for authorized readers to drain (rendezvous
    // role): {"<source>": {"filter": null | [NIP-01 filters]}}.
    "BUZZ_REPLICATION_STREAMS": "",
    // Source-controlled reader trust for exported streams; same shape as
    // BUZZ_REPLICATION_PEERS. Empty = nothing is drainable (fail closed).
    "BUZZ_REPLICATION_READERS": "",
    // Owner identity anchor (pubkey hex). When set together with
    // BUZZ_NODE_LABEL, owner-signed kind-30700 declaration heads in this
    // node's journal govern peers/readers/streams per domain, and the
    // BUZZ_REPLICATION_* vars above become bootstrap-only (consulted solely
    // for domains with no declaration head). Identity, not policy — stable
    // across deploys.
    "BUZZ_OWNER_PUBKEY": "9c2fd8696a630bdf27c3d54394739bb3cbbf81b7cf7fa1e205a806eca33fa90e",
    // This node's label. Only declarations n-tagged with it govern here:
    // journals replicate whole, so one owner's declarations for different
    // nodes coexist in every copy, and each node evaluates only its own.
    "BUZZ_NODE_LABEL": "cf-rendezvous"
  },
  // Content-addressed blob custody (artifact store). Create the bucket once:
  //   wrangler r2 bucket create buzz-portable-relay-artifacts
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "buzz-portable-relay-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_NODES",
        "class_name": "RelayNode"
      }
    ]
  },
  "exports": {
    "RelayNode": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
